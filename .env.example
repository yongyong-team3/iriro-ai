# 데이터 출처: replay(시연) | safetydata(재난안전데이터공유플랫폼) | hrfco(직접 API)
DATA_SOURCE=replay
# safetydata 모드에 필요한 각 API 서비스 키. 실제 값은 .env에만 입력하세요.
SAFETYDATA_WATER_KEY=
SAFETYDATA_RAIN_KEY=
# 재생 모드: 시작 시각과 속도(실제 1분에 데이터 몇 분이 흐르는지)
REPLAY_START=2026-07-09T06:00
REPLAY_SPEED=10
# 실시간 모드: 한강홍수통제소 Open API 키 (깃허브 등에 올리지 마세요)
HRFCO_API_KEY=
# 키 발급 후 실제 주소 형식이 다르면 아래로 바꿀 수 있어요
# HRFCO_WL_URL=https://api.hrfco.go.kr/{key}/waterlevel/list/10M/{code}/{start}/{end}.json
# HRFCO_RF_URL=https://api.hrfco.go.kr/{key}/rainfall/list/10M/{code}/{start}/{end}.json
